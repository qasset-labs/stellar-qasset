// Contract
// ============================================================

#[contract]
pub struct QAssetRegistry;

#[contractimpl]
impl QAssetRegistry {
    /// Constructor arguments are committed in the deployment transaction, removing any
    /// separately callable first-initializer race. This admin only registers metadata tenants.
    pub fn __constructor(env: Env, admin: Address) {
        env.storage().instance().set(&ADMIN, &admin);
        touch_instance(&env);
    }

    /// Creates a metadata tenant with consent from both registrar and tenant administrator.
    /// This does not prove ownership or control of the address named by `asset`.
    pub fn register_asset(env: Env, asset: Address, admin: Address) -> Result<(), Error> {
        let registrar: Address = env.storage().instance().get(&ADMIN).unwrap();
        registrar.require_auth();
        if admin != registrar {
            admin.require_auth();
        }
        if env.storage().persistent().has(&asset_key(&asset)) {
            return Err(Error::AssetAlreadyRegistered);
        }
        for role in Role::ALL {
            if env
                .storage()
                .persistent()
                .has(&role_key(&env, &asset, role))
            {
                return Err(Error::OrphanedPolicy);
            }
        }
        let policy = AssetPolicy {
            admin: admin.clone(),
            revision: 0,
        };
        write_policy(&env, &asset, &policy);
        AssetAdminChanged {
            asset,
            admin,
            revision: 0,
        }
        .publish(&env);
        Ok(())
    }

    pub fn asset_admin(env: Env, asset: Address) -> Result<Address, Error> {
        Ok(load_policy(&env, &asset)?.admin)
    }

    /// The registrar has no override; both outgoing and incoming administrators consent.
    pub fn transfer_asset_admin(env: Env, asset: Address, admin: Address) -> Result<(), Error> {
        let mut policy = load_policy(&env, &asset)?;
        policy.admin.require_auth();
        if admin != policy.admin {
            admin.require_auth();
        }
        policy.admin = admin.clone();
        policy.revision = policy
            .revision
            .checked_add(1)
            .ok_or(Error::RevisionOverflow)?;
        write_policy(&env, &asset, &policy);
        AssetAdminChanged {
            asset,
            admin,
            revision: policy.revision,
        }
        .publish(&env);
        Ok(())
    }

    /// Any keeper can extend live entries. Archived entries need network restoration first.
    pub fn keep_alive(env: Env, asset: Address) -> Result<(), Error> {
        load_policy(&env, &asset)?;
        for role in Role::ALL {
            let key = role_key(&env, &asset, role);
            if env.storage().persistent().has(&key) {
                touch_persistent(&env, &key);
            }
        }
        Ok(())
    }

    /// Registers (or replaces) the authorization quorum for one (asset, role) pair.
    ///
    /// Fails closed on nonsensical input: `threshold == 0`, any signer with `weight == 0`, a
    /// threshold whose summed signer weight could never reach it, a duplicate signer address,
    /// weights above 255, or a signer count exceeding this registry's bounded policy limit.
    pub fn set_role_quorum(
        env: Env,
        asset: Address,
        role: Role,
        quorum: Quorum,
    ) -> Result<(), Error> {
        let mut policy = load_policy(&env, &asset)?;
        policy.admin.require_auth();

        if quorum.threshold == 0 {
            return Err(Error::ZeroThreshold);
        }
        if quorum.signers.len() > MAX_SIGNERS {
            return Err(Error::TooManySigners);
        }

        let mut total_weight: u32 = 0;
        for i in 0..quorum.signers.len() {
            let signer = quorum.signers.get(i).unwrap();
            if signer.weight == 0 {
                return Err(Error::ZeroSignerWeight);
            }
            if signer.weight > MAX_SIGNER_WEIGHT {
                return Err(Error::SignerWeightTooHigh);
            }
            for j in (i + 1)..quorum.signers.len() {
                if quorum.signers.get(j).unwrap().address == signer.address {
                    return Err(Error::DuplicateSigner);
                }
            }
            total_weight = total_weight
                .checked_add(signer.weight)
                .ok_or(Error::WeightOverflow)?;
        }
        if quorum.threshold > total_weight {
            return Err(Error::ThresholdUnreachable);
        }

        policy.revision = policy
            .revision
            .checked_add(1)
            .ok_or(Error::RevisionOverflow)?;
        let key = role_key(&env, &asset, role);
        env.storage().persistent().set(&key, &quorum);
        touch_persistent(&env, &key);
        write_policy(&env, &asset, &policy);

        QuorumSet {
            asset: asset.clone(),
            role,
            threshold: quorum.threshold,
            signers: quorum.signers.clone(),
            revision: policy.revision,
        }
        .publish(&env);

        Ok(())
    }

    /// Returns the registered quorum for (asset, role), if any.
    pub fn get_role_quorum(env: Env, asset: Address, role: Role) -> Option<Quorum> {
        env.storage()
            .persistent()
            .get(&role_key(&env, &asset, role))
    }

    /// Evaluates declared algorithms and weights, returning a weak path if the declared
    /// classical weight reaches threshold. `None` does not establish actual PQ protection.
    fn evaluate_role(env: &Env, asset: &Address, role: Role) -> Option<WeakPath> {
        let quorum: Option<Quorum> = env.storage().persistent().get(&role_key(env, asset, role));
        let quorum = match quorum {
            Some(q) => q,
            None => {
                return Some(WeakPath {
                    role,
                    reason: WeakPathReason::Unregistered,
                    classical_weight: 0,
                    post_quantum_weight: 0,
                    threshold: 0,
                })
            }
        };

        let mut classical_weight: u32 = 0;
        let mut post_quantum_weight: u32 = 0;
        for signer in quorum.signers.iter() {
            if signer.algo.is_post_quantum() {
                post_quantum_weight += signer.weight;
            } else {
                classical_weight += signer.weight;
            }
        }

        // The security-critical line: a role is weak iff its threshold is meetable using
        // classical signers ALONE, i.e. without needing even one PQ signature. Merely having a
        // PQ signer present in the quorum is not sufficient — if the summed weight of classical
        // signers alone already reaches the threshold, an adversary who has broken every
        // classical key in the quorum never needs to forge the PQ one at all.
        if classical_weight >= quorum.threshold {
            Some(WeakPath {
                role,
                reason: WeakPathReason::ThresholdMeetableClassically,
                classical_weight,
                post_quantum_weight,
                threshold: quorum.threshold,
            })
        } else {
            None
        }
    }

    /// Returns weak paths in declared metadata only. Empty does not prove actual asset safety;
    /// signer algorithms, role coverage, and registry administration remain unverified.
    pub fn list_weak_paths(env: Env, asset: Address) -> Vec<WeakPath> {
        let mut out = Vec::new(&env);
        for role in Role::ALL {
            if let Some(weak) = Self::evaluate_role(&env, &asset, role) {
                out.push_back(weak);
            }
        }
        out
    }

    /// Computes the deterministic QS0-QS4 level for `asset` from its currently registered
    /// control graph. See `QsLevel`'s own doc comments for the exact rule at each level.
    pub fn declared_security_level(env: Env, asset: Address) -> QsLevel {
        let mut weak_roles: Map<Role, WeakPath> = Map::new(&env);
        for role in Role::ALL {
            if let Some(weak) = Self::evaluate_role(&env, &asset, role) {
                weak_roles.set(role, weak);
            }
        }

        let any_pq_signer_anywhere = Role::ALL.iter().any(|role| {
            let quorum: Option<Quorum> = env
                .storage()
                .persistent()
                .get(&role_key(&env, &asset, *role));
            quorum
                .map(|q| q.signers.iter().any(|s| s.algo.is_post_quantum()))
                .unwrap_or(false)
        });

        if !any_pq_signer_anywhere {
            return QsLevel::Qs0;
        }

        let highest_impact_weak = Role::HIGHEST_IMPACT
            .iter()
            .any(|role| weak_roles.contains_key(*role));

        if highest_impact_weak {
            return QsLevel::Qs1;
        }

        let any_role_weak = !weak_roles.is_empty();

        if any_role_weak {
            return QsLevel::Qs2;
        }

        // Declared QS3 from here. Assume all classical signers compromised: QS4 additionally
        // requires that they cannot reach threshold together with any ONE declared PQ signer.
        // Merely checking individual signer weight would incorrectly promote a classical/PQ
        // 2-of-2 quorum even though compromising its one PQ key then completes the quorum.
        let highest_impact_all_multisig = Role::HIGHEST_IMPACT.iter().all(|role| {
            let quorum: Option<Quorum> = env
                .storage()
                .persistent()
                .get(&role_key(&env, &asset, *role));
            quorum
                .map(|q| {
                    let mut classical_weight = 0u32;
                    let mut largest_pq_weight = 0u32;
                    for signer in q.signers.iter() {
                        if signer.algo.is_post_quantum() {
                            largest_pq_weight = largest_pq_weight.max(signer.weight);
                        } else {
                            classical_weight += signer.weight;
                        }
                    }
                    classical_weight + largest_pq_weight < q.threshold
                })
                .unwrap_or(false)
        });

        if highest_impact_all_multisig {
            QsLevel::Qs4
        } else {
            QsLevel::Qs3
        }
    }

    /// Returns an explicitly unverified metadata snapshot, versioned for change detection.
    pub fn policy_assessment(env: Env, asset: Address) -> Result<PolicyAssessment, Error> {
        let policy = load_policy(&env, &asset)?;
        Ok(PolicyAssessment {
            asset: asset.clone(),
            declared_level: Self::declared_security_level(env.clone(), asset),
            policy_revision: policy.revision,
            ledger_sequence: env.ledger().sequence(),
            verification: VerificationStatus::Unverified,
        })
    }

    /// A computed declaration is not a verified security rating. No administrator can promote
    /// a policy to verified by setting a flag or approving an algorithm label.
    pub fn quantum_security_level(_env: Env, _asset: Address) -> Result<QsLevel, Error> {
        Err(Error::UnverifiedPolicy)
    }

    /// Fail closed even for QS0: unverified metadata must never authorize an operation.
    pub fn require_min_qs(_env: Env, _asset: Address, _min_level: QsLevel) -> Result<(), Error> {
        Err(Error::UnverifiedPolicy)
    }
}

