//! Q-Asset: bounded analysis of administrator-declared weighted authorization policies.
//!
//! Signer algorithms and role coverage are metadata, not verified on-chain evidence. The
//! declared QS level must never be presented as an asset's verified quantum security level.
//! The verification and enforcement APIs fail closed until an audited integration can prove
//! actual signer algorithms, complete authority coverage, and configuration integrity.

#![no_std]

use soroban_sdk::{
    contract, contracterror, contractevent, contractimpl, contracttype, symbol_short, Address, Env,
    Map, Symbol, Vec,
};

// ============================================================
// Types
// ============================================================

/// Administrator-declared signature algorithm; not evidence of actual authentication.
///
/// Used only to calculate declared policy. The registry cannot verify a signer's actual
/// account code, verifier, upgrade path, keys, or authentication algorithm. Implementing such
/// checks requires a separate, reviewed integration with complete asset authority coverage.
#[contracttype]
#[derive(Clone, Debug, Eq, PartialEq)]
pub enum SignerAlgo {
    /// Classic Stellar account signer. Broken by a cryptographically-relevant quantum computer
    /// (Shor's algorithm against the underlying elliptic curve).
    Ed25519,
    /// secp256r1 (WebAuthn/passkey-style signers). Equally quantum-vulnerable as Ed25519.
    Secp256r1,
    /// ML-DSA-44 (FIPS 204, NIST security level 2).
    MlDsa44,
    /// ML-DSA-65 (FIPS 204, NIST security level 3). The level SDF's Quantum Preparedness Plan
    /// Stage 1 targets first for Soroban host-function acceleration.
    MlDsa65,
    /// ML-DSA-87 (FIPS 204, NIST security level 5).
    MlDsa87,
}

impl SignerAlgo {
    pub fn is_post_quantum(&self) -> bool {
        matches!(
            self,
            SignerAlgo::MlDsa44 | SignerAlgo::MlDsa65 | SignerAlgo::MlDsa87
        )
    }
}

/// One signer inside a role's authorization quorum.
///
/// `weight` mirrors Stellar's real classic-account multisig model directly (each signer has a
/// weight, and a threshold is met once the summed weight of participating signers reaches it)
/// rather than simplifying to unweighted 1-signer-1-vote counting — a control graph that can't
/// represent "the CEO's key is weight 3, the two co-signers are weight 1 each" doesn't actually
/// describe weighted Stellar multisig policy. Address identity and actual key independence
/// are unverified; the algorithm field is only a declaration.
#[contracttype]
#[derive(Clone, Debug, Eq, PartialEq)]
pub struct Signer {
    pub address: Address,
    pub algo: SignerAlgo,
    pub weight: u32,
}

/// A weighted authorization quorum for one critical role, matching Stellar's own
/// signer-weight/threshold multisig model.
///
/// `threshold` is the summed signer *weight* required to authorize an operation gated by this
/// role, not a signer count — a quorum of one weight-3 signer and one weight-1 signer with
/// threshold 3 is satisfied by the first signer alone, exactly as it would be on a real Stellar
/// account.
#[contracttype]
#[derive(Clone, Debug)]
pub struct Quorum {
    pub signers: Vec<Signer>,
    pub threshold: u32,
}

/// A critical authority every tokenized asset's control graph is checked against.
///
/// This exact set mirrors the original Q-Asset/PQ-RWA proposal's own enumeration: mint, burn,
/// freeze, clawback, treasury, upgrade, governance, recovery.
#[contracttype]
#[derive(Clone, Copy, Debug, Eq, PartialEq)]
pub enum Role {
    Mint,
    Burn,
    Freeze,
    Clawback,
    Treasury,
    Upgrade,
    Governance,
    Recovery,
}

impl Role {
    /// All 8 tracked critical roles, in a fixed order used for iteration.
    pub const ALL: [Role; 8] = [
        Role::Mint,
        Role::Burn,
        Role::Freeze,
        Role::Clawback,
        Role::Treasury,
        Role::Upgrade,
        Role::Governance,
        Role::Recovery,
    ];

    /// Highest-impact roles in this declared model. Their real authority and their ability to
    /// change other operations depend on an asset's actual implementation, which is unverified.
    pub const HIGHEST_IMPACT: [Role; 3] = [Role::Treasury, Role::Upgrade, Role::Governance];
}

/// Declared Quantum Security level for one asset's registered metadata, QS0-QS4.
///
/// Monotonic within this declared model; none proves actual asset security. See
/// docs/ARCHITECTURE.md "QS0-QS4 standard" for the full rationale and worked examples.
#[contracttype]
#[derive(Clone, Copy, Debug, Eq, PartialEq)]
#[repr(u32)]
pub enum QsLevel {
    /// No post-quantum signer declared anywhere in the policy.
    Qs0 = 0,
    /// At least one PQ signer is declared, but a highest-impact role is missing or has a
    /// declared quorum meetable using classical signers alone.
    Qs1 = 1,
    /// All highest-impact declared quorums need PQ weight; at least one other role is missing
    /// or classically meetable within the declaration.
    Qs2 = 2,
    /// All 8 roles are declared and no declared quorum is classically meetable. This does not
    /// verify that actual operations enforce those quorums or that algorithms are genuine.
    Qs3 = 3,
    /// Declared QS3 plus at least two declared PQ addresses are needed for each highest-impact
    /// quorum, even with every classical signer compromised. Distinct underlying keys,
    /// controllers, algorithms, and complete actual authority coverage remain unverified.
    Qs4 = 4,
}

/// A single weak path: a critical role whose current quorum can still be satisfied using
/// classical signers alone, with the declared classical and PQ weights that produced the
/// finding. This is metadata analysis and does not establish an actual exploit path.
#[contracttype]
#[derive(Clone, Debug)]
pub struct WeakPath {
    pub role: Role,
    pub reason: WeakPathReason,
    pub classical_weight: u32,
    pub post_quantum_weight: u32,
    pub threshold: u32,
}

#[contracttype]
#[derive(Clone, Debug, Eq, PartialEq)]
pub enum WeakPathReason {
    /// The role has no registered quorum at all. Treated as maximally weak: an unregistered
    /// role is not "safe by omission", it's an authority this registry has no visibility into
    /// and therefore cannot vouch for — the conservative, fail-closed reading.
    Unregistered,
    /// The role's quorum threshold can be met by counting classical signers alone, so a
    /// The declared classical weight reaches threshold without any declared PQ contribution.
    ThresholdMeetableClassically,
}

#[contracterror]
#[derive(Clone, Copy, Debug, Eq, PartialEq)]
#[repr(u32)]
pub enum Error {
    NotAdmin = 1,
    /// The threshold exceeds the summed weight of every signer in the quorum — no combination
    /// of signatures could ever satisfy it, regardless of who signs.
    ThresholdUnreachable = 2,
    ZeroThreshold = 3,
    AssetNotRegistered = 4,
    QsLevelTooLow = 5,
    /// A signer was registered with `weight == 0` — such a signer can never contribute toward
    /// any threshold and its presence would misrepresent the quorum's real composition.
    ZeroSignerWeight = 6,
    /// An asset already has an administrator; the registrar cannot overwrite it.
    AssetAlreadyRegistered = 7,
    /// The same signer address appears more than once in a single quorum. Counted once each,
    /// duplicates would inflate that address's effective weight in the classical/PQ tally.
    /// Distinct addresses do not themselves establish distinct keys or independent controllers.
    DuplicateSigner = 8,
    /// The quorum exceeds this registry's 20-entry resource bound. This is a policy limit,
    /// not Stellar's protocol total: classic accounts can also have a separate master key.
    TooManySigners = 9,
    /// Declared algorithms and role mappings do not prove real asset authority coverage.
    UnverifiedPolicy = 10,
    /// Individual weights are bounded to Stellar classic's unsigned-byte weight range.
    SignerWeightTooHigh = 11,
    WeightOverflow = 12,
    RevisionOverflow = 13,
    /// Role declarations exist without their tenant metadata. Restore original metadata;
    /// re-enrollment must not inherit or silently reset an orphaned policy.
    OrphanedPolicy = 14,
}

/// Resource bound for a declared policy, not a claim about the protocol's total signer count.
const MAX_SIGNERS: u32 = 20;
const MAX_SIGNER_WEIGHT: u32 = 255;
// Approximately seven days at five seconds per ledger; capped to the network's max TTL.
const TTL_TARGET: u32 = 120_960;

#[contracttype]
#[derive(Clone, Debug, Eq, PartialEq)]
pub enum VerificationStatus {
    Unverified,
}

/// A point-in-time declaration. Revision covers both quorum and administrator changes.
/// Ledger sequence records observation time; it is not a cryptographic attestation.
#[contracttype]
#[derive(Clone, Debug, Eq, PartialEq)]
pub struct PolicyAssessment {
    pub asset: Address,
    pub declared_level: QsLevel,
    pub policy_revision: u64,
    pub ledger_sequence: u32,
    pub verification: VerificationStatus,
}

#[contracttype]
#[derive(Clone, Debug)]
struct AssetPolicy {
    admin: Address,
    revision: u64,
}

#[contractevent]
#[derive(Clone, Debug)]
pub struct AssetAdminChanged {
    #[topic]
    pub asset: Address,
    pub admin: Address,
    pub revision: u64,
}

fn asset_key(asset: &Address) -> (Symbol, Address) {
    (symbol_short!("ASSET"), asset.clone())
}

fn touch_instance(env: &Env) {
    let target = env.storage().max_ttl().min(TTL_TARGET);
    env.storage().instance().extend_ttl(target / 2, target);
}

fn touch_persistent<K: soroban_sdk::IntoVal<Env, soroban_sdk::Val>>(env: &Env, key: &K) {
    let target = env.storage().max_ttl().min(TTL_TARGET);
    env.storage()
        .persistent()
        .extend_ttl(key, target / 2, target);
}

fn load_policy(env: &Env, asset: &Address) -> Result<AssetPolicy, Error> {
    let key = asset_key(asset);
    let policy = env
        .storage()
        .persistent()
        .get(&key)
        .ok_or(Error::AssetNotRegistered)?;
    touch_persistent(env, &key);
    touch_instance(env);
    Ok(policy)
}

fn write_policy(env: &Env, asset: &Address, policy: &AssetPolicy) {
    let key = asset_key(asset);
    env.storage().persistent().set(&key, policy);
    touch_persistent(env, &key);
    touch_instance(env);
}

const ADMIN: Symbol = symbol_short!("ADMIN");

/// Emitted every time a role's quorum is registered or replaced, so an off-chain scanner or
/// dashboard (M2) can watch for a downgrade by subscribing to this event instead of having to
/// poll every registered asset's every role on a schedule to notice a regression.
#[contractevent]
#[derive(Clone, Debug)]
pub struct QuorumSet {
    #[topic]
    pub asset: Address,
    #[topic]
    pub role: Role,
    pub threshold: u32,
    pub signers: Vec<Signer>,
    pub revision: u64,
}

fn role_key(_env: &Env, asset: &Address, role: Role) -> (Symbol, Address, Role) {
    (symbol_short!("ROLE"), asset.clone(), role)
}

